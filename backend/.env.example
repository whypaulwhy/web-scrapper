# Copy this file to backend/.env and fill in ONE free AI API key.
#   cp backend/.env.example backend/.env

# --- Option 1 (default): Google Gemini ---------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Option 2: Groq ----------------------------------------------------------
# Get a free key at https://console.groq.com/keys
# GROQ_API_KEY=
# Optional: override the model (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: force a provider ("gemini" or "groq"). If unset, whichever key is present is used.
# AI_PROVIDER=gemini

# Optional: port for the local API server (default: 3001)
# PORT=3001
